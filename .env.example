# Bắt buộc: token của bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Bắt buộc: một hoặc nhiều ID người dùng Discord được phép dùng bot, cách nhau
# bằng dấu phẩy. Người khác gọi /meraky hay bấm nút điều khiển đều bị từ chối.
# Lấy ID: Discord > Cài đặt > Nâng cao > bật Developer Mode, rồi nhấp chuột
# phải vào tên > Copy User ID.
# Ví dụ một người: 123456789012345678
# Ví dụ nhiều người: 123456789012345678,234567890123456789
ALLOWED_USER_ID=

# Tùy chọn: ID server dùng để test. Khi có, lệnh /meraky được đăng ký riêng cho
# server này và xuất hiện ngay lập tức. Bỏ trống để đăng ký toàn cục (có thể mất
# vài phút mới hiện ở mọi server).
DISCORD_GUILD_ID=

# Tùy chọn: token Genius (https://genius.com/api-clients). Không có thì bot vẫn
# tìm lời bài hát được, chỉ kém ổn định hơn.
GENIUS_API_KEY=

# Tùy chọn: cookie YouTube dạng JSON array (xuất bằng extension "EditThisCookie"
# hoặc "Cookie-Editor"). Giúp tránh lỗi "Sign in to confirm you're not a bot"
# khi chạy trên server/cloud.
YOUTUBE_COOKIES=

# Tùy chọn: đường dẫn tới yt-dlp, dùng làm phương án dự phòng khi YouTube chặn.
# Mặc định tìm "yt-dlp" trong PATH. Image Docker đã cài sẵn.
YTDLP_PATH=

# Tùy chọn: số giây chờ trước khi rời kênh thoại khi không còn ai / hết nhạc.
IDLE_TIMEOUT_SECONDS=120
